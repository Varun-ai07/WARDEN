# API
PORT=8787
APP_ORIGIN=http://localhost:5173
SESSION_SECRET=change_me_to_a_random_secret
DATABASE_PATH=apps/api/data/warden.db

# Reasoning adapter: fake | openai
REASONER_MODE=openai
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_TITLE=WARDEN

# Database (for Vercel deployment with Supabase)
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Execution adapter: fake | prava
PAYMENT_PROVIDER_MODE=prava
PRAVA_API_KEY=your_prava_api_key
PRAVA_BASE_URL=https://sandbox.api.prava.space
PRAVA_PUBLISHABLE_KEY=your_prava_publishable_key
PRAVA_WEBHOOK_SECRET=
